{
	"compilerOptions": {
		"rootDir": ".",
		"esModuleInterop": true,
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"declaration": false,
		"outDir": "./dist"
	},
	"include": [
		"integration-tests/**/*.ts",
		"src/**/*.ts",
		"@types/*.ts"
	]
}
