{
	"compilerOptions": {
		"rootDir": "./src",
		"esModuleInterop": true,
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"declaration": true,
		"outDir": "./dist"
	},
	"include": [
		"integration-tests",
		"src",
		"@types"
	]
}
