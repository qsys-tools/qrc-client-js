{
	"extends": "../../tsconfig.options.json",
	"references": [
		{
			"path": "../reconnectable"
		},
		{
			"path": "../websocket-events"
		}
	],
	"compilerOptions": {
		"paths": {
			"@qsys-tools/reconnectable": [
				"../reconnectable/src/index.ts"
			],
			"@qsys-tools/reconnectable/*": [
				"../reconnectable/src/*"
			],
			"@qsys-tools/websocket-events": [
				"../websocket-events/src/index.ts"
			],
			"@qsys-tools/websocket-events/*": [
				"../websocket-events/src/*"
			]
		}
	}
}
