{
	"name": "@qsys-tools/json-rpc-channel",
	"version": "0.4.0",
	"description": "JSON RPC over tcp streams or websockets.",
	"license": "MIT",
	"repository": "qsys-tools/qrc-client-js",
	"author": {
		"name": "James Talmage",
		"email": "james.talmage@jrtechnical.com",
		"url": "http://jrtechnical.com"
	},
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"build": "tsc -b",
		"prepublishOnly": "npm test && npm run test-noop",
		"test": "xo && tsc -b && ava",
		"lint": "xo",
		"format": "xo --fix",
		"test-only": "ava",
		"test-noop": "ava -- --noop-validator",
		"generate-types": "node src/validation/_generate-types.ts > src/validation/generated-types.ts"
	},
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"production": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"type": "module",
	"files": [
		"dist"
	],
	"keywords": [
		"Q-SYS",
		"QSC",
		"control",
		"client"
	],
	"dependencies": {
		"@logtape/logtape": "catalog:",
		"debug": "catalog:",
		"partysocket": "catalog:",
		"pump": "catalog:",
		"split2": "catalog:",
		"through2": "catalog:",
		"typescript-event-target": "catalog:",
		"ws": "catalog:"
	},
	"devDependencies": {
		"@types/duplexify": "catalog:",
		"@types/node": "catalog:",
		"@types/pump": "catalog:",
		"@types/readable-stream": "catalog:",
		"@types/split2": "catalog:",
		"@types/ws": "catalog:",
		"ava": "catalog:",
		"c8": "catalog:",
		"duplexify": "catalog:",
		"eslint": "catalog:",
		"make-dir": "catalog:",
		"p-event": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"vitest-monocart-coverage": "catalog:",
		"xo": "catalog:"
	},
	"ava": {
		"extensions": [
			"ts"
		],
		"nodeArguments": [
			"--experimental-strip-types"
		]
	},
	"xo": [
		{
			"files": [
				"**"
			],
			"rules": {
				"@typescript-eslint/naming-convention": "off",
				"@stylistic/quote-props": [
					"error",
					"consistent-as-needed"
				]
			}
		}
	]
}
