{
	"name": "qsys-qrc-client",
	"version": "0.4.0",
	"description": "An external control client for QSC Q-SYS cores, written in Node.js.",
	"license": "MIT",
	"repository": "qsys-tools/qrc-client-js",
	"author": {
		"name": "James Talmage",
		"email": "james.talmage@jrtechnical.com",
		"url": "http://jrtechnical.com"
	},
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"build": "tsc -b",
		"prepublishOnly": "npm test && npm run test-noop",
		"test": "xo && tsc -b && ava",
		"lint": "xo",
		"format": "xo --fix",
		"test-only": "ava",
		"test-noop": "ava -- --noop-validator",
		"generate-types": "node src/validation/_generate-types.ts > src/validation/generated-types.ts"
	},
	"main": "dist/index.js",
	"type": "module",
	"files": [
		"dist"
	],
	"keywords": [
		"Q-SYS",
		"QSC",
		"control",
		"client"
	],
	"dependencies": {
		"@qsys-tools/json-rpc-channel": "workspace:*",
		"any-observable": "catalog:",
		"supports-color": "catalog:",
		"through2": "catalog:",
		"uuid": "catalog:"
	},
	"devDependencies": {
		"@types/is-ci": "catalog:",
		"@types/node": "catalog:",
		"@types/pump": "catalog:",
		"@types/readable-stream": "catalog:",
		"@types/split2": "catalog:",
		"@types/ws": "catalog:",
		"@types/zen-observable": "catalog:",
		"ava": "catalog:",
		"delay": "catalog:",
		"eslint": "catalog:",
		"is-ci": "catalog:",
		"make-dir": "catalog:",
		"p-event": "catalog:",
		"typescript": "catalog:",
		"ws": "catalog:",
		"xo": "catalog:",
		"zen-observable": "catalog:",
		"zod-to-ts": "catalog:"
	},
	"peerDependencies": {
		"zod": "^4.4.3"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"ava": {
		"files": [
			"src/*.test.ts",
			"src/**/*.test.ts",
			"integration-tests/*.test.ts"
		],
		"require": [
			"any-observable/register/zen"
		],
		"extensions": [
			"ts"
		],
		"nodeArguments": [
			"--experimental-strip-types"
		]
	},
	"xo": [
		{
			"files": [
				"**"
			],
			"rules": {
				"@typescript-eslint/naming-convention": "off",
				"@stylistic/quote-props": [
					"error",
					"consistent-as-needed"
				]
			}
		},
		{
			"ignores": [
				"**/src/validation/generated-types.ts"
			]
		}
	]
}
