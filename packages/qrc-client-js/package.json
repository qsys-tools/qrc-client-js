{
	"name": "qsys-qrc-client",
	"version": "0.4.0",
	"description": "An external control client for QSC Q-SYS cores, written in Node.js.",
	"license": "MIT",
	"repository": "qsys-tools/qrc-client-js",
	"author": {
		"name": "James Talmage",
		"email": "james.talmage@jrtechnical.com",
		"url": "http://jrtechnical.com"
	},
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"build": "tsc -b",
		"prepare": "npm run build",
		"prepublishOnly": "npm test && npm run test-noop",
		"test": "xo && tsc -b && ava",
		"lint": "xo",
		"format": "xo --fix",
		"test-only": "ava",
		"test-noop": "ava -- --noop-validator",
		"generate-types": "node src/validation/_generate-types.ts > src/validation/generated-types.ts"
	},
	"main": "dist/index.js",
	"type": "module",
	"files": [
		"dist"
	],
	"keywords": [
		"Q-SYS",
		"QSC",
		"control",
		"client"
	],
	"dependencies": {
		"any-observable": "^0.6.0",
		"pump": "^3.0.4",
		"split2": "^4.2.0",
		"supports-color": "^10.2.2",
		"through2": "^5.0.0",
		"uuid": "^14.0.0",
		"ws": "^8.20.1"
	},
	"devDependencies": {
		"@types/is-ci": "^3.0.4",
		"@types/node": "^25.6.2",
		"@types/pump": "^1.1.3",
		"@types/readable-stream": "^4.0.23",
		"@types/split2": "^4.2.3",
		"@types/ws": "^8.18.1",
		"@types/zen-observable": "^0.8.7",
		"ava": "^8.0.0",
		"delay": "^7.0.0",
		"eslint": "^10.3.0",
		"is-ci": "^4.1.0",
		"make-dir": "^5.1.0",
		"p-event": "^7.1.0",
		"typescript": "^6.0.3",
		"xo": "^2.0.2",
		"zen-observable": "^0.10.0",
		"zod-to-ts": "^2.0.0"
	},
	"peerDependencies": {
		"zod": "^4.4.3"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"ava": {
		"files": [
			"src/*.test.ts",
			"src/**/*.test.ts",
			"integration-tests/*.test.ts"
		],
		"require": [
			"any-observable/register/zen"
		],
		"extensions": [
			"ts"
		],
		"nodeArguments": [
			"--experimental-strip-types"
		]
	}
}
